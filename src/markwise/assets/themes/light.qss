QWidget { background-color: #f4f6f9; color: #1f2933; font-size: 10pt; }
QLabel { background: transparent; }
QLineEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTableWidget, QTreeWidget {
    background-color: #ffffff; color: #1f2933; border: 1px solid #c3cad5; border-radius: 4px;
    padding: 3px; selection-background-color: #2f6fed; selection-color: #ffffff;
}
QPushButton { background-color: #2f6fed; color: #ffffff; border: none; border-radius: 4px; padding: 6px 12px; }
QPushButton:hover { background-color: #2559c4; }
QPushButton:disabled { background-color: #a9b4c6; color: #eef1f6; }
QHeaderView::section { background-color: #e3e8ef; color: #1f2933; padding: 4px; border: none; border-right: 1px solid #c3cad5; }
QMenuBar, QMenu { background-color: #ffffff; color: #1f2933; }
QMenu::item:selected, QMenuBar::item:selected { background-color: #2f6fed; color: #ffffff; }
QProgressBar { border: 1px solid #c3cad5; border-radius: 4px; text-align: center; background-color: #ffffff; }
QProgressBar::chunk { background-color: #2f6fed; }
QSplitter::handle { background-color: #c3cad5; }
QToolTip { background-color: #ffffff; color: #1f2933; border: 1px solid #c3cad5; }
