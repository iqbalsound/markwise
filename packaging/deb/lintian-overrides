# MarkWise is a third-party application, not part of the Debian archive.
# It is built with PyInstaller and bundles its own Python and Qt libraries,
# so it is installed under /opt and cannot use the system copies.
# The bundled libraries are intentionally NOT stripped: stripping breaks
# NumPy's bundled OpenBLAS library.
markwise: dir-or-file-in-opt
markwise: embedded-library
markwise: unstripped-binary-or-object
